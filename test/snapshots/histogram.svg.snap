<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 300" class="chart chart-histogram" role="img" aria-labelledby="dps-histogram-title dps-histogram-desc"><title id="dps-histogram-title">DPS per iteration, 10 fights</title><desc id="dps-histogram-desc">Histogram of the DPS of each of 10 fights in 4 bins of 5.0 DPS, from 140.0 to 160.0 DPS. Mean 149.8 DPS, 95% confidence interval 146.5 to 153.2 DPS. The tallest bin has 4 fights.</desc><g class="chart-axes" font-size="11" fill="currentColor"><line x1="80" y1="252" x2="620" y2="252" class="chart-axis-line" stroke="currentColor"></line><line x1="80" y1="28" x2="80" y2="252" class="chart-axis-line" stroke="currentColor"></line><line x1="80" y1="252" x2="80" y2="257" stroke="currentColor"></line><text x="80" y="265" text-anchor="middle" dominant-baseline="hanging">140</text><line x1="215" y1="252" x2="215" y2="257" stroke="currentColor"></line><text x="215" y="265" text-anchor="middle" dominant-baseline="hanging">145</text><line x1="350" y1="252" x2="350" y2="257" stroke="currentColor"></line><text x="350" y="265" text-anchor="middle" dominant-baseline="hanging">150</text><line x1="485" y1="252" x2="485" y2="257" stroke="currentColor"></line><text x="485" y="265" text-anchor="middle" dominant-baseline="hanging">155</text><line x1="620" y1="252" x2="620" y2="257" stroke="currentColor"></line><text x="620" y="265" text-anchor="middle" dominant-baseline="hanging">160</text><line x1="75" y1="252" x2="80" y2="252" stroke="currentColor"></line><line x1="80" y1="252" x2="620" y2="252" class="chart-grid" stroke="currentColor" stroke-opacity="0.15"></line><text x="67" y="252" text-anchor="end" dominant-baseline="middle">0</text><line x1="75" y1="196" x2="80" y2="196" stroke="currentColor"></line><line x1="80" y1="196" x2="620" y2="196" class="chart-grid" stroke="currentColor" stroke-opacity="0.15"></line><text x="67" y="196" text-anchor="end" dominant-baseline="middle">1</text><line x1="75" y1="140" x2="80" y2="140" stroke="currentColor"></line><line x1="80" y1="140" x2="620" y2="140" class="chart-grid" stroke="currentColor" stroke-opacity="0.15"></line><text x="67" y="140" text-anchor="end" dominant-baseline="middle">2</text><line x1="75" y1="84" x2="80" y2="84" stroke="currentColor"></line><line x1="80" y1="84" x2="620" y2="84" class="chart-grid" stroke="currentColor" stroke-opacity="0.15"></line><text x="67" y="84" text-anchor="end" dominant-baseline="middle">3</text><line x1="75" y1="28" x2="80" y2="28" stroke="currentColor"></line><line x1="80" y1="28" x2="620" y2="28" class="chart-grid" stroke="currentColor" stroke-opacity="0.15"></line><text x="67" y="28" text-anchor="end" dominant-baseline="middle">4</text><text x="350" y="278" class="chart-axis-title" text-anchor="middle" dominant-baseline="hanging">DPS</text><text x="16" y="140" class="chart-axis-title" text-anchor="middle" transform="rotate(-90 16 140)">Fights</text></g><g class="chart-ci"><rect class="chart-ci-band" x="254.46" y="28" width="182.99" height="224" fill="currentColor" fill-opacity="0.12"></rect><line x1="254.46" y1="28" x2="254.46" y2="252" class="chart-ci-edge" stroke="currentColor" stroke-dasharray="4 3"></line><line x1="437.44" y1="28" x2="437.44" y2="252" class="chart-ci-edge" stroke="currentColor" stroke-dasharray="4 3"></line></g><g class="chart-bars"><rect class="chart-bar" x="80" y="196" width="135" height="56" fill="currentColor" fill-opacity="0.55" stroke="currentColor" stroke-opacity="0.9"><title>140.0–145.0 DPS: 1 fight</title></rect><rect class="chart-bar" x="215" y="84" width="135" height="168" fill="currentColor" fill-opacity="0.55" stroke="currentColor" stroke-opacity="0.9"><title>145.0–150.0 DPS: 3 fights</title></rect><rect class="chart-bar" x="350" y="28" width="135" height="224" fill="currentColor" fill-opacity="0.55" stroke="currentColor" stroke-opacity="0.9"><title>150.0–155.0 DPS: 4 fights</title></rect><rect class="chart-bar" x="485" y="140" width="135" height="112" fill="currentColor" fill-opacity="0.55" stroke="currentColor" stroke-opacity="0.9"><title>155.0–160.0 DPS: 2 fights</title></rect></g><g class="chart-mean-marker"><line x1="345.95" y1="28" x2="345.95" y2="252" class="chart-mean" stroke="currentColor" stroke-width="2"></line><text x="350.95" y="36" class="chart-mean-label" font-size="11" fill="currentColor" dominant-baseline="hanging">mean 149.8</text></g><g class="chart-legend" font-size="11" fill="currentColor"><line x1="80" y1="16" x2="98" y2="16" class="chart-mean" stroke="currentColor" stroke-width="2"></line><text x="103" y="16" dominant-baseline="middle">mean DPS</text><rect x="169" y="11" width="18" height="10" class="chart-ci-band" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-dasharray="3 2"></rect><text x="192" y="16" dominant-baseline="middle">95% confidence interval</text></g></svg>

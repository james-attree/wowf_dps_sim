<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 300" class="chart chart-timeline" role="img" aria-labelledby="damage-timeline-title damage-timeline-desc"><title id="damage-timeline-title">Cumulative damage over a 4 s fight, mean of 3 fights</title><desc id="damage-timeline-desc">Line chart of the mean damage dealt from the start of the fight, second by second, over 3 fights of 4 s, with a band from the lowest to the highest fight. At the end the mean is 433.3 damage, the lowest fight 380.0 and the highest 470.0.</desc><g class="chart-axes" font-size="11" fill="currentColor"><line x1="80" y1="252" x2="620" y2="252" class="chart-axis-line" stroke="currentColor"></line><line x1="80" y1="28" x2="80" y2="252" class="chart-axis-line" stroke="currentColor"></line><line x1="80" y1="252" x2="80" y2="257" stroke="currentColor"></line><text x="80" y="265" text-anchor="middle" dominant-baseline="hanging">0</text><line x1="215" y1="252" x2="215" y2="257" stroke="currentColor"></line><text x="215" y="265" text-anchor="middle" dominant-baseline="hanging">1</text><line x1="350" y1="252" x2="350" y2="257" stroke="currentColor"></line><text x="350" y="265" text-anchor="middle" dominant-baseline="hanging">2</text><line x1="485" y1="252" x2="485" y2="257" stroke="currentColor"></line><text x="485" y="265" text-anchor="middle" dominant-baseline="hanging">3</text><line x1="620" y1="252" x2="620" y2="257" stroke="currentColor"></line><text x="620" y="265" text-anchor="middle" dominant-baseline="hanging">4</text><line x1="75" y1="252" x2="80" y2="252" stroke="currentColor"></line><line x1="80" y1="252" x2="620" y2="252" class="chart-grid" stroke="currentColor" stroke-opacity="0.15"></line><text x="67" y="252" text-anchor="end" dominant-baseline="middle">0</text><line x1="75" y1="207.2" x2="80" y2="207.2" stroke="currentColor"></line><line x1="80" y1="207.2" x2="620" y2="207.2" class="chart-grid" stroke="currentColor" stroke-opacity="0.15"></line><text x="67" y="207.2" text-anchor="end" dominant-baseline="middle">100</text><line x1="75" y1="162.4" x2="80" y2="162.4" stroke="currentColor"></line><line x1="80" y1="162.4" x2="620" y2="162.4" class="chart-grid" stroke="currentColor" stroke-opacity="0.15"></line><text x="67" y="162.4" text-anchor="end" dominant-baseline="middle">200</text><line x1="75" y1="117.6" x2="80" y2="117.6" stroke="currentColor"></line><line x1="80" y1="117.6" x2="620" y2="117.6" class="chart-grid" stroke="currentColor" stroke-opacity="0.15"></line><text x="67" y="117.6" text-anchor="end" dominant-baseline="middle">300</text><line x1="75" y1="72.8" x2="80" y2="72.8" stroke="currentColor"></line><line x1="80" y1="72.8" x2="620" y2="72.8" class="chart-grid" stroke="currentColor" stroke-opacity="0.15"></line><text x="67" y="72.8" text-anchor="end" dominant-baseline="middle">400</text><line x1="75" y1="28" x2="80" y2="28" stroke="currentColor"></line><line x1="80" y1="28" x2="620" y2="28" class="chart-grid" stroke="currentColor" stroke-opacity="0.15"></line><text x="67" y="28" text-anchor="end" dominant-baseline="middle">500</text><text x="350" y="278" class="chart-axis-title" text-anchor="middle" dominant-baseline="hanging">Fight time (s)</text><text x="16" y="140" class="chart-axis-title" text-anchor="middle" transform="rotate(-90 16 140)">Damage dealt</text></g><polygon class="chart-band" points="80,252 215,117.6 350,117.6 485,95.2 620,41.44 620,81.76 485,131.04 350,175.84 215,216.16 80,252" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-opacity="0.5" stroke-dasharray="3 2"></polygon><polyline class="chart-line chart-mean" points="80,252 215,180.32 350,137.01 485,114.61 620,57.87" fill="none" stroke="currentColor" stroke-width="2"></polyline><g class="chart-legend" font-size="11" fill="currentColor"><line x1="80" y1="16" x2="98" y2="16" class="chart-mean" stroke="currentColor" stroke-width="2"></line><text x="103" y="16" dominant-baseline="middle">mean damage</text><rect x="187" y="11" width="18" height="10" class="chart-band" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-dasharray="3 2"></rect><text x="210" y="16" dominant-baseline="middle">lowest to highest fight</text></g></svg>
